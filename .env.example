# MongoDB connection string. Required when NODE_ENV=production.
MONGO_URI=mongodb://localhost:27017/kisansetu
# MONGODB_URI is also accepted by common hosting providers; set only one.
NODE_ENV=development
PORT=3000
# Keep true only for local testing without MongoDB
ALLOW_MEMORY_STORAGE=True
# Browser-restricted key for Maps JavaScript, Places, and Geocoding APIs.
GOOGLE_MAPS_API_KEY=your-browser-restricted-google-maps-key